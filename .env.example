# ---------- LLM (Anthropic Claude) ----------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
JAA_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = deeper analysis, more tokens)
JAA_LLM_EFFORT=high

# ---------- Jenkins ----------
JAA_JENKINS_URL=https://jenkins.internal.example.com
JAA_JENKINS_USER=ai-analyser-bot
JAA_JENKINS_API_TOKEN=xxxxxxxx
# Comma-separated jobs to backfill / watch (folder paths use "/")
JAA_JENKINS_JOBS=platform/main-build,platform/verify
JAA_JENKINS_VERIFY_SSL=true

# ---------- Gerrit ----------
JAA_GERRIT_ENABLED=true
JAA_GERRIT_URL=https://gerrit.internal.example.com
JAA_GERRIT_USER=ai-analyser-bot
# Gerrit "HTTP Credentials" password (Settings > HTTP Credentials), NOT the LDAP password
JAA_GERRIT_HTTP_PASSWORD=xxxxxxxx

# ---------- Jira ----------
JAA_JIRA_ENABLED=true
JAA_JIRA_URL=https://yourcompany.atlassian.net
# Jira Cloud: email + API token.   Jira Server/DC: leave JIRA_EMAIL empty, put a PAT in JIRA_TOKEN
JAA_JIRA_EMAIL=bot@yourcompany.com
JAA_JIRA_TOKEN=xxxxxxxx
JAA_JIRA_PROJECT_KEY=CI
JAA_JIRA_ISSUE_TYPE=Bug
# Only file a ticket when the analysis confidence is at least this (0-1)
JAA_JIRA_MIN_CONFIDENCE=0.6

# ---------- Service ----------
# Shared secret Jenkins sends in the X-JAA-Token header
JAA_WEBHOOK_TOKEN=change-me-long-random-string
JAA_DB_PATH=/data/analyser.db
# Max characters of console log sent to the LLM after extraction
JAA_MAX_LOG_CHARS=60000
